{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:deploy": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "POSTGRES_URL_NON_POOLING"
      ]
    },
    "@eng/landing#build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "META_ACCESS_TOKEN",
        "META_TEST_EVENT_CODE",
        "ESKIZ_EMAIL",
        "ESKIZ_PASSWORD",
        "ESKIZ_FROM",
        "ESKIZ_MODE",
        "ESKIZ_CALLBACK_URL",
        "SMS_ALLOWED_PHONES"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@eng/admin#build": {
      "dependsOn": ["^build", "^db:deploy"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "CRON_SECRET",
        "ZOOM_ACCOUNT_ID",
        "ZOOM_CLIENT_ID",
        "ZOOM_CLIENT_SECRET",
        "ZOOM_WEBHOOK_SECRET_TOKEN",
        "RECORDING_WORKER_URL",
        "RECORDING_CALLBACK_SECRET",
        "ESKIZ_EMAIL",
        "ESKIZ_PASSWORD",
        "ESKIZ_FROM",
        "ESKIZ_MODE",
        "ESKIZ_CALLBACK_URL",
        "ESKIZ_WEBHOOK_SECRET",
        "SMS_ALLOWED_PHONES"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "CRON_SECRET",
        "ZOOM_ACCOUNT_ID",
        "ZOOM_CLIENT_ID",
        "ZOOM_CLIENT_SECRET",
        "ZOOM_WEBHOOK_SECRET_TOKEN",
        "RECORDING_WORKER_URL",
        "RECORDING_CALLBACK_SECRET",
        "ESKIZ_EMAIL",
        "ESKIZ_PASSWORD",
        "ESKIZ_FROM",
        "ESKIZ_MODE",
        "ESKIZ_CALLBACK_URL",
        "ESKIZ_WEBHOOK_SECRET",
        "SMS_ALLOWED_PHONES"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
