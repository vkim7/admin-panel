{
  "name": "eng-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate --workspace=@eng/database",
    "db:seed": "npm run db:seed --workspace=@eng/database",
    "db:studio": "npm run db:studio --workspace=@eng/database"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "npm@10.9.2"
}
